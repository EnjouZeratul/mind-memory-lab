# openai | ollama | anthropic | dashscope（阿里云百炼 OpenAI 兼容，与 HR_system 一致）
MIND_LLM_PROVIDER=dashscope

# --- 百炼 DashScope（与 D:\HR_system 中 chat_service 用法一致）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# 国际区 Key 时使用: https://dashscope-intl.aliyuncs.com/compatible-mode
# R1 等在流式响应里带 reasoning_content；Web 以 SSE event「reasoning」推送，并写入会话 JSON 的助手 reasoning 字段。
DASHSCOPE_MODEL=deepseek-r1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 数据与会话、SQLite 索引目录
MIND_DATA_DIR=

# 设为 1 时在数据目录写入 memory 事件 JSONL（便于审计，可选）
MIND_MEMORY_EVENTS=

# 编排：1 强制单轮对话；缺省允许至多两轮（启发式 + 低置信触发）
MIND_TURN_PASSES_MAX=

# 算力面占位：local（默认）| cloud（仅写入路由结果，首版不切换第二端点）
MIND_COMPUTE_DEFAULT=

# 对话交付：unified_agent（默认，记忆+工作区证据 + 工具链，由模型决定是否联网）| memory_pipeline（仅旧编排）
MIND_CHAT_DELIVERY=unified_agent

# 仅官方 OpenAI 等支持 `tool_choice: required` / 指定 function 时设为 1。
# DashScope 等兼容端只接受 auto|none；未设置时自动将强制项降为 auto，避免 400。
MIND_OPENAI_TOOL_CHOICE_STRICT=

# 助手回合是否先做环境联网检索（与问法无关；0|false|off 关闭以省请求）
MIND_AGENT_AMBIENT_PREFETCH=1

# Agent 工具回合：写入与 memory 同目录 events.jsonl，kind 含 agent（可选）
MIND_AGENT_EVENTS=
# 单请求内模型发起 tool 的最大轮次（默认 8，上限 16）
MIND_AGENT_MAX_TOOL_ROUNDS=
# 每轮补全 max_tokens 上限（默认 2048；上限 8192、下限 256）
MIND_AGENT_MAX_TOKENS=
# 达到 tool 轮次上限后最后一轮 max_tokens（默认 1024）
MIND_AGENT_MAX_TOKENS_FINAL=
# OpenAI 兼容 chat/completions 单次请求超时毫秒（默认 120000，上限 300000）
MIND_AGENT_OPENAI_TIMEOUT_MS=
# 逗号分隔的 UTF-8 文件路径，内容拼入 system 技能片段（可选）
MIND_AGENT_SKILL_FILES=

# 只读工作区根（用于片段检索）
MIND_WORKSPACE_ROOT=

# --- 联网检索（助手模式 web_search；默认 DuckDuckGo Instant Answer，无需密钥）---
# 留空或 duckduckgo：Instant Answer（结果偏少但免密钥）
# tavily：需 MIND_TAVILY_API_KEY，结果更全
# none | off：关闭联网（工具仍可能被调用，返回空列表）
MIND_WEB_SEARCH_PROVIDER=
MIND_TAVILY_API_KEY=
